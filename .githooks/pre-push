#!/usr/bin/env bash
# Opt-in pre-push hook for wacp-platform.
#
# Runs cargo fmt --check + cargo clippy before the push succeeds so
# fmt/clippy drift fails locally rather than in CI. Adds ~2–5 min
# per push depending on the cargo cache state.
#
# Install:  ./scripts/install-hooks.sh
# Bypass once:  git push --no-verify
# Uninstall:  git config --unset core.hooksPath

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "==> cargo fmt --check --all"
cargo fmt --check --all

echo "==> cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

echo "pre-push OK"
