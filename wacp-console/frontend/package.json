{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --shard=1/3 && vitest run --shard=2/3 && vitest run --shard=3/3",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:ci": "vitest run --coverage",
    "test:isolated": "bash scripts/run-tests-isolated.sh",
    "test:e2e": "bash scripts/e2e-cleanup.sh && playwright test",
    "test:e2e:ui": "bash scripts/e2e-cleanup.sh && playwright test --ui",
    "test:e2e:debug": "bash scripts/e2e-cleanup.sh && playwright test --debug",
    "test:e2e:coverage": "bash scripts/e2e-cleanup.sh && E2E_COVERAGE=1 playwright test",
    "coverage": "vitest run --coverage",
    "coverage:e2e": "c8 report --reporter=lcov --reporter=text-summary --reports-dir=coverage/e2e --src=src --temp-directory=coverage/playwright-raw --all --include='src/**/*.{ts,tsx}' --exclude='src/**/*.test.{ts,tsx}' --exclude='src/**/__tests__/**'",
    "gen:api": "openapi-typescript ../openapi.yaml -o src/api/types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "c8": "^10.1.3",
    "eslint": "^10.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-router": "^7.14.1",
    "react-virtuoso": "^4.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  }
}
